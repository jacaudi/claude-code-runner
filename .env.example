# GitHub Personal Access Token (required)
# Needs repo, read:org, and workflow permissions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (optional)
# If not set, falls back to OAuth token from mounted ~/.claude directory
ANTHROPIC_API_KEY=

# Authentication Settings
# Path to store auth credentials (default: /data/auth.json)
AUTH_FILE=/data/auth.json

# Session secret for cookie signing (auto-generated if not set)
# Recommended: Set this to a random string for production
SESSION_SECRET=

# Dispatch mode: "local" (default) or "kubernetes"
# local: spawns Claude processes via node-pty on the host
# kubernetes: creates Kubernetes Jobs for each task phase
DISPATCH_MODE=local

# Kubernetes settings (only used when DISPATCH_MODE=kubernetes)
K8S_NAMESPACE=default
K8S_IMAGE=ericvtheg/claude-code-runner
K8S_SERVICE_ACCOUNT=
K8S_CPU_LIMIT=2
K8S_MEMORY_LIMIT=4Gi
K8S_CPU_REQUEST=500m
K8S_MEMORY_REQUEST=1Gi
K8S_CREDENTIALS_SECRET=claude-credentials
K8S_GITHUB_TOKEN_SECRET=github-token
